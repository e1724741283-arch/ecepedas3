<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ecepedas3.Views.registro"
             Title="registro">
    <VerticalStackLayout
        Spacing="10"
        Padding="10">
        <Label 
            Text="REGISTRO DE USUARIO"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
            <Entry x:Name="txtUsuarioNuevo" Placeholder="Ingrese su usuario" />
            <Entry x:Name="txtContrasenaNueva" Placeholder="Contraseña nueva" IsPassword="True" />
            <Button x:Name="btnGuardar" Text="Guardar Usuario" Clicked="btnGuardar_Clicked" />
    </VerticalStackLayout>
</ContentPage>