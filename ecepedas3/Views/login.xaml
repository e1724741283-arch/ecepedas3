<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ecepedas3.Views.login"
             Title="login">
    <VerticalStackLayout
        Margin="20"
        Spacing="10"
        Padding="10"
        
        >
        <Label 
            Text="INICIAR SESIÓN"
            VerticalOptions="Center" 
            FontSize="20"
            HorizontalOptions="Center"/>
        <!--<Image Source="https://www.uisrael.edu.ec/wp-content/uploads/2019/03/untitled-2-min-1.png" WidthRequest="300"/>-->
        <Image Source="uisrael.jpg" WidthRequest="200"/>
        <Grid RowSpacing="15" ColumnSpacing ="10" HorizontalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Text="Usuario:" FontSize="18" Grid.Row="0" Grid.Column="0"/>
            <Entry x:Name="txtUsuario" Placeholder="Ingrese su usuario" Grid.Row="0" Grid.Column="1"/>
            <Label Text= "Contraseña :" FontSize="18" Grid.Row="1" Grid.Column="0"/>
            <Entry x:Name="txtContrasena" Placeholder="Ingrese la contraseña" IsPassword="True" Grid.Row="1" Grid.Column="1"/>
            <Button x:Name="btnLogin" Text="Iniciar Sesión" Clicked="btnIniciarSesion_Clicked" Grid.Row="2" Grid.Column="1"/>
           <Button x:Name="btnRegister" Text="Registrarse" Clicked="btnRegister_Clicked" Grid.Row="2" Grid.Column="0" />
        </Grid>

    </VerticalStackLayout>
</ContentPage>